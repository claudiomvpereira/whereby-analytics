# Copie para .env (que está no .gitignore) e preencha localmente. Nunca faça commit do .env.
# Chave da API REST do Whereby Embedded (Dashboard > Configure > API > Generate key).
# Recomendado: chave dedicada a este projeto, com expiração de 7 ou 30 dias.
WHEREBY_API_KEY=
# Segredo para pseudonimização HMAC (gere com: python -c "import secrets;print(secrets.token_hex(32))")
PSEUDONYM_SECRET=
